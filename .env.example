# Copy this file to .env and fill in real values. Never commit .env.

# Base URL of the Tableau Server/Online instance, no trailing path.
TABLEAU_SERVER_URL=https://insight.erajaya.com

# Tableau site content URL (empty string for the Default site).
TABLEAU_SITE=

# Tableau credentials. Prefer a Personal Access Token over a password if
# your Tableau instance supports it (would require adding
# TABLEAU_TOKEN_NAME / TABLEAU_TOKEN_SECRET support to auth.py).
TABLEAU_USERNAME=
TABLEAU_PASSWORD=

# The view ID (not the friendly URL) for ReturnRotate/Dashboard1.
TABLEAU_VIEW_ID=

# Tableau REST API version, e.g. 3.29. Leave blank to auto-detect it at
# startup via the server's unauthenticated /api/*/serverinfo endpoint.
TABLEAU_API_VERSION=

# Where exports are written; date-based subfolders are created under this.
EXPORT_DIR=exports

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
